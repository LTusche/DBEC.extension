<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        HorizontalContentAlignment="Center"
        Height="700"
        Width="900"
        Title="Echtzeit-Koordination Konfiguration"
        Closed="onClosed">
    <Window.Resources>
        <DataTemplate x:Key="CheckListItemCategory" >
            <CheckBox IsChecked="{Binding checked}" Content="{Binding name}" IsTabStop="false" Checked="CategoriesChanged" Unchecked="CategoriesChanged"/>
        </DataTemplate>
        <DataTemplate x:Key="CheckListItemLink" >
            <CheckBox IsChecked="{Binding checked}" Content="{Binding name}" IsTabStop="false" IsEnabled="{Binding enabled}"/>
        </DataTemplate>
    </Window.Resources>
    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="10,7,10,3">
            <CheckBox x:Name="UpdaterStatusBox" Checked="toggleCheckbox" Unchecked="toggleCheckbox" 
                Content="Echtzeitprüfung Inaktiv"/>
        </StackPanel>
        <GroupBox Grid.Row="1" x:Name="LinkBox" Header="Modelle" Margin="2" Padding="2" IsEnabled="True">
            <DockPanel>
                <!--Grid DockPanel.Dock="Bottom" Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Margin="6" Content="Alle markieren" Click="SelectAllLinks"/>
                    <Button Margin="6" Grid.Column="1" Content="Keine markieren" Click="SelectNoLinks"/>
                </Grid-->
                <ListBox
                x:Name="LinksBox"
                ItemTemplate="{StaticResource CheckListItemLink}"
                ItemsSource="{Binding links}"
                TabIndex="1">
                </ListBox>
            </DockPanel>
        </GroupBox>
        <GroupBox Grid.Row="2" x:Name="CatBox" Header="Kategorien" Margin="2" Padding="2" IsEnabled="True">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <!--CheckBox IsChecked="{Binding strictSearch}" Content="Strikt"/-->
                    <TextBlock Text="Suchen"/>
                    <TextBox x:Name="catSearch" Grid.Column="1" TextChanged="updateCategories" TabIndex="0"/>
                </Grid>
                <Grid DockPanel.Dock="Bottom" Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Margin="6" Content="Alle markieren" Click="SelectAllCats"/>
                    <Button Margin="6" Grid.Column="1" Content="Keine markieren" Click="SelectNoCats"/>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ausgewählt:"/>
                        <TextBlock x:Name="selectedCatCount" Margin="0,-3,0,0" Text="0" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
                <ListBox
                    x:Name="CategoriesBox"
                    ItemTemplate="{StaticResource CheckListItemCategory}"
                    ItemsSource="{Binding visibleCategories}"
                    PreviewKeyDown="ListBox_PreviewKeyDown"
                    TabIndex="1">
                </ListBox>
            </DockPanel>
        </GroupBox>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto" MinWidth="150"/>
                <ColumnDefinition Width="Auto" MinWidth="150"/>
            </Grid.ColumnDefinitions>
            <Button Content="Fertigstellen und Prüfung ausführen (Beta)" Margin="7" Padding="3" Grid.Column="1" Click="confirmAndCheck"/>
            <Button Content="Fertigstellen" Margin="7" Padding="3" Grid.Column="2" Click="confirmAndClose"/>
        </Grid>
    </Grid>
</Window>
