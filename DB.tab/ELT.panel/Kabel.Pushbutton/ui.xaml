<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        HorizontalContentAlignment="Center"
        Height="700"
        Width="900"
        Title="Kabelsystem Konfiguration"
        Closed="onClosed">
    <Window.Resources>
    </Window.Resources>
    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="10,7,10,7">
            <CheckBox x:Name="UpdaterStatusBox" Checked="toggleCheckbox" Unchecked="toggleCheckbox" 
                Content="Updater Inaktiv" DockPanel.Dock="Left"/>
            <!--Button Content="Anleitung" DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="5,2,5,2"/-->
        </DockPanel>
        <GroupBox Grid.Row="1" Header="Systemzuordnung" Margin="2" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Grid Margin="4,2,1,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Räume" />
                    <ComboBox x:Name="roomPhaseBox" Grid.Column="1"/>
                    <ComboBox x:Name="roomTypeBox" Grid.Column="3"/>
                </Grid>
                <DataGrid x:Name="ElementsListView"
                    Grid.Row="1"
                    MinHeight="20"
                    VirtualizingStackPanel.VirtualizationMode="Recycling" 
                    AlternationCount="2"
                    AlternatingRowBackground="WhiteSmoke"
                    SelectionMode="Single"
                    SelectionUnit="Cell"
                    CanUserAddRows="false"
                    CanUserDeleteRows="false"
                    DataGridCell.GotFocus="DataGrid_StartCellEdit">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Systemname" Binding="{Binding Name}" IsReadOnly="true" Width="2*"/>
                        <!--DataGridComboBoxColumn x:Name="wireTypeColumn" Header="Verkabelungsart" SelectedItemBinding="{Binding WiringType}" Width="2*"/-->
                        <DataGridTemplateColumn x:Name="wireTypeColumnButton" Header="Verkabelungsart" Width="2*">
                            <DataGridTemplateColumn.CellTemplate> 
                              <DataTemplate> 
                                <Button Click="verkabelungsartButtonClick" Content="{Binding WiringType.Name}"/>
                              </DataTemplate> 
                            </DataGridTemplateColumn.CellTemplate> 
                          </DataGridTemplateColumn>
                        <DataGridComboBoxColumn x:Name="phaseColumn" Header="Revit Phase (Verteilerbereich)" Width="4*" SelectedItemBinding = "{Binding Phase}"/>
                        <DataGridComboBoxColumn x:Name="typeColumn" Header="Typ" Width="1*" SelectedItemBinding = "{Binding Type}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel x:Name="LoadingPanel"
                    Orientation="Horizontal"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,5">
                    <StackPanel.Triggers>
                        <EventTrigger RoutedEvent="Rectangle.Loaded">
                            <BeginStoryboard x:Name="waitingAnimation">
                            <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="Dot1" BeginTime="0:0:0.1" Storyboard.TargetProperty="Opacity" From="0" To="1" AutoReverse="True" Duration="0:0:0.4"/>
                            <DoubleAnimation Storyboard.TargetName="Dot2" BeginTime="0:0:0.2" Storyboard.TargetProperty="Opacity" From="0" To="1" AutoReverse="True" Duration="0:0:0.4"/>
                            <DoubleAnimation Storyboard.TargetName="Dot3" BeginTime="0:0:0.3" Storyboard.TargetProperty="Opacity" From="0" To="1" AutoReverse="True" Duration="0:0:0.4"/>
                            </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </StackPanel.Triggers>
                    <Ellipse Name="Dot1" Fill="Black" Opacity="0" Width="8" Height="8"/>
                    <Ellipse Name="Dot2" Fill="Black" Opacity="0" Width="8" Height="8" Margin="2,0,0,0"/>
                    <Ellipse Name="Dot3" Fill="Black" Opacity="0" Width="8" Height="8" Margin="2,0,0,0"/>
                </StackPanel>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="2" Header="Einstellungen" Margin="2" Padding="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Revit-Kabel Erstellen (Beta)" Margin="0,2,0,0"/>
                <CheckBox Grid.Row="0" Grid.Column="1" x:Name="createWires" Margin="0,2,0,0"/>
                <!--TextBlock Grid.Row="1" Text="Systemparameter Trennzeichen  "/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="SeperatorBox" Text=";" MaxLength="1"/-->
            </Grid>
        </GroupBox>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <Button Content="Fertigstellen" Margin="7" Padding="3" Grid.Column="1" Click="confirmAndClose"/>
        </Grid>
    </Grid>
</Window>
